# Zapp sibling repository dependency lockfile.
# CI verifies that the checked-out zappMessaging SHA matches before building.
# Update when intentionally bumping a sibling dependency.

# The published SDK, whose history is squashed and so carries its own commit ids:
# this repository pins the mirror, not the development repo it is published from.
# GitHub: https://github.com/JustZappIt/zappmessaging-sdk
zappMessaging=58f3cc72792d5efe663ebb4fd397f845dfcec2ac

# bare-kit is a direct clone of holepunchto/bare-kit v2.0.0 with no Zapp modifications.
# GitHub: https://github.com/holepunchto/bare-kit
# The local ../bare-kit/ directory has no git history; CI checks out the pinned commit.
# Update both this SHA and the workflow ref when upgrading bare-kit.
bare-kit=15a3569f3d704de7151761051c8d9cc2e299414f

# The Zcash SDK is our NU7 build of 3.2.1 on librustzcash's final releases: CI builds it from
# SDK_COMMIT_PIN in gradle.properties, and releases build it from a checkout of the same commit
# through SDK_INCLUDED_BUILD_PATH. The published 3.2.1-SNAPSHOT can't sign after NU7 activates.
#
# v3.2.1 is the last MIT release. From v3.3.0 the SDK is AGPL-3.0-only and its
# LICENSE-EXCEPTIONS.md grants no Google Play permission to anyone but Znewco, so moving past
# 3.2.1 is a licensing decision, not a routine bump.
#
# Slipstream: 3.2.1's sdk-incubator still depends on zcash-android-sdk-slipstream at runtime
# (63 slipstream paths in the tagged tree, IS_SLIPSTREAM_ENABLED=true). -SNAPSHOT is mutable,
# so re-check both whenever this moves. See docs/voting.md.
#
# GitHub: https://github.com/JustZappIt/zodl-android-wallet-sdk (branch feature/nu7-mainnet)
zcashAndroidWalletSdk=4305333423c0685fe1bd7ba3ede0caa2b8fef95f

# Atomic swap Kotlin wrapper and prebuilt Android native libraries.
# GitHub: https://github.com/JustZappIt/zecSwap
zecSwap=8a5c642571ec730dcf0b0c2359484c2c71ae341d
