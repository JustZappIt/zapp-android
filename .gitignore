docs/android/

# Design prototypes: raw capture dumps, not a build input
design/

# Solana dApp Store config (stored privately in GCS)
stores/config.yaml

# Installed dependencies. The blind-push deployment directory is meant to have
# `npm ci` run inside it, so without this a routine `git add -A` there commits
# the whole dependency tree.
**/node_modules/
