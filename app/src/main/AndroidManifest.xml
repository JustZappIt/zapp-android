<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allow zappMessaging (minSdk 29) on minSdk 27 host app -->
    <uses-sdk tools:overrideLibrary="xyz.justzappit.zappmessaging, to.holepunch.bare.kit" />

    <application
        android:name="co.electriccoin.zcash.app.ZcashApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/auto_backup_config"
        android:dataExtractionRules="@xml/auto_backup_config_android_12"
        android:backupInForeground="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher_square"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:memtagMode="async"
        android:supportsRtl="false"
        android:label="@string/app_name">

        <!-- Apps targeting API 36 have screenOrientation / resizableActivity / aspect-ratio
             restrictions ignored on displays with a smallest width of 600dp or more, which would
             unlock landscape on tablets and unfolded foldables for the portrait-only layouts.
             This property keeps the API 35 behaviour; it stops being honoured at API 37, so the
             layouts have to be made adaptive before the next target-SDK bump. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true"
            tools:targetApi="31" />

        <!-- Alias acts as the entrypoint to the application.
             Using an alias ensures we can refactor the actual Activity without breaking
             clients. -->
        <activity-alias
            android:name="co.electricoin.zcash.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity="co.electriccoin.zcash.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zcash" />
            </intent-filter>
            <!--
              Gift links, as their own filter rather than merged into the zcash one above: merging
              would make the app claim zcash://gift.justzappit.xyz and bare https:// as well, both
              wrong. Intent filters cannot match on a fragment and never strip one, so the bearer
              secret after '#' arrives intact via intent.data.fragment.

              autoVerify needs assetlinks.json served from the host; until that exists the link
              opens in a browser instead, which degrades to the landing page rather than breaking.
              Test without any of it using an explicit-package intent:
                adb shell am start -a android.intent.action.VIEW -d '<link>' <applicationId>
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="gift.justzappit.xyz"
                    android:pathPrefix="/c/"
                    android:scheme="https" />
            </intent-filter>
        </activity-alias>

        <!-- Enable profiling by benchmark -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <provider
            android:name="co.electriccoin.zcash.global.ShareFileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_file_provider_paths" />
        </provider>

    </application>

</manifest>
