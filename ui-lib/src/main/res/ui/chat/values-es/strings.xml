    <!-- Chat profile — P2P wallet key row & reveal dialog -->
    <string name="chat_profile_p2p_key_title">Clave de la billetera P2P</string>
    <string name="chat_profile_p2p_key_subtitle">Clave de tu cuenta de retiro P2P, derivada de tu frase de recuperación</string>
    <string name="chat_profile_p2p_key_biometric_prompt">Ver la clave de tu billetera P2P</string>
    <string name="chat_p2p_key_title">Clave de cartera P2P</string>
    <string name="chat_p2p_key_info_content_description">Cómo funciona la clave P2P</string>
    <string name="chat_p2p_key_info_title">Sobre tu clave P2P</string>
    <string name="chat_p2p_key_info_derivation">Esta clave se deriva de tu frase semilla por una ruta propia. No es tu clave de gasto de Zcash y no puede tocar tus ZEC. Perder la app no la pierde: la misma semilla siempre vuelve a derivar la misma clave.</string>
    <string name="chat_p2p_key_info_smart_account">Controla una cuenta inteligente. La dirección por la que se liquidan tus cobros es una cuenta de contrato en Base gobernada por esta clave, y eso permite que Zapp cubra las comisiones de red para que nunca necesites gas.</string>
    <string name="chat_p2p_key_info_safety">Quien tenga la clave privada controla esa cuenta y los fondos que haya en ella. Expórtala solo si necesitas mover esos fondos con otra cartera.</string>
    <string name="chat_p2p_key_smart_account_label">Cuenta inteligente</string>
    <string name="chat_p2p_key_smart_account_caption">La cuenta de Base por la que se liquidan tus cobros P2P. Se puede compartir.</string>
    <string name="chat_p2p_key_owner_label">Clave propietaria</string>
    <string name="chat_p2p_key_owner_locked_body">La clave privada que controla la cuenta inteligente. Para mostrarla se pide antes tu bloqueo de app.</string>
    <string name="chat_p2p_key_reveal">Mostrar clave propietaria</string>
    <string name="chat_p2p_key_owner_address_label">Dirección propietaria</string>
    <string name="chat_p2p_key_owner_address_caption">La dirección derivada de la clave propietaria. Se puede compartir.</string>
    <string name="chat_p2p_key_private_key_label">Clave privada</string>
    <string name="chat_p2p_key_private_key_caption">No la compartas nunca. Quien la tenga puede gastar todo lo que haya en la cuenta inteligente.</string>
    <string name="chat_p2p_key_copy_content_description">Copiar</string>

