    <string name="chat_settings_background_push_toggle_subtitle">Activa el servicio persistente sin Google</string>
    <string name="chat_settings_section_privacy">Privacidad</string>
    <string name="chat_settings_read_receipts_toggle_title">Confirmaciones de lectura</string>
    <string name="chat_settings_read_receipts_toggle_subtitle">Muestra una doble marca cuando leen tus mensajes. Desactívala para dejar de ver también cuándo leen los tuyos.</string>
    <string name="read_receipts_settings_row_subtitle">Controla los indicadores de enviado y leído en los chats</string>
    <string name="read_receipts_settings_title">Confirmaciones de lectura</string>
    <string name="read_receipts_settings_intro">Las confirmaciones de lectura permiten que un chat muestre cuándo se abrió un mensaje. Son opcionales y solo muestran el estado leído cuando ambas partes las permiten.</string>
    <string name="read_receipts_settings_on_title">Cuando está activado</string>
    <string name="read_receipts_settings_on_body">Cuando abres una conversación, Zapp puede enviar una pequeña señal de lectura para los mensajes que recibiste. Tus mensajes enviados también pueden mostrar una doble marca cercana después de que la otra app confirme que fueron leídos.</string>
    <string name="read_receipts_settings_off_title">Cuando está desactivado</string>
    <string name="read_receipts_settings_off_body">Zapp no enviará señales de lectura cuando abras mensajes y no mostrará el estado leído de otras personas. Los mensajes permanecen como enviados en lugar de leídos.</string>
    <string name="read_receipts_settings_both_sides_title">Si la otra persona lo tiene desactivado</string>
    <string name="read_receipts_settings_both_sides_body">Las dobles marcas requieren que ambas partes permitan las confirmaciones de lectura. Si cualquiera las desactiva, ese chat funciona solo con estado enviado.</string>
    <string name="read_receipts_settings_section_control">Control</string>
    <string name="read_receipts_settings_toggle_title">Permitir confirmaciones de lectura</string>
    <string name="read_receipts_settings_toggle_subtitle">Enviar y mostrar el estado leído cuando ambas partes lo permitan</string>
    <string name="read_receipts_settings_save">Guardar</string>
    <string name="chat_message_status_sending">Enviando</string>
    <string name="chat_message_status_queued">Esperando que el destinatario sincronice</string>
    <string name="chat_message_status_sent">Enviado, pendiente de entrega</string>
    <string name="chat_message_status_delivered">Entregado</string>
    <string name="chat_message_status_read">Leído</string>
    <string name="chat_message_status_failed">Error al enviar</string>
    <string name="background_delivery_settings_title">Entrega en segundo plano</string>
    <string name="background_delivery_settings_intro">En FOSS, la entrega en segundo plano mantiene activo un servicio sin Google cuando Zapp está cerrado.</string>
    <string name="background_delivery_settings_delivery_title">Cuando está desactivado</string>
    <string name="background_delivery_settings_delivery_body">Zapp detiene el servicio. Los mensajes siguen cifrados y se sincronizan cuando vuelves a abrir la app.</string>
    <string name="background_delivery_settings_battery_title">Cuando está activado</string>
    <string name="background_delivery_settings_battery_body">Android muestra una notificación permanente de “Zapp está activo” y mantiene una conexión ntfy. Esto usa más batería que revisar solo al abrir la app.</string>
    <string name="background_delivery_settings_privacy_title">Qué contiene la señal de entrega</string>
    <string name="background_delivery_settings_privacy_body">La señal solo le indica a Zapp que se despierte y revise mensajes. El contenido de los mensajes permanece cifrado y tu app lo obtiene después de despertarse.</string>
    <string name="background_delivery_settings_section_control">Control</string>
    <string name="background_delivery_settings_toggle_title">Permitir entrega en segundo plano</string>
    <string name="background_delivery_settings_toggle_subtitle">Despertar Zapp para revisar mensajes pendientes</string>
    <string name="background_delivery_settings_save">Guardar</string>

