    <string name="chat_settings_read_receipts_toggle_title">Read receipts</string>
    <string name="chat_settings_read_receipts_toggle_subtitle">Show a double tick when your messages are read. Turn off to also stop seeing when others read yours.</string>
    <string name="read_receipts_settings_row_subtitle">Control sent and read indicators for chats</string>
    <string name="read_receipts_settings_title">Read receipts</string>
    <string name="read_receipts_settings_intro">Read receipts let a chat show when a message has been opened. They are optional and only show read status when both sides allow them.</string>
    <string name="read_receipts_settings_on_title">When this is on</string>
    <string name="read_receipts_settings_on_body">When you open a conversation, Zapp can send a small read signal for messages you received. Your outgoing messages can also show a close double tick after the other app confirms they were read.</string>
    <string name="read_receipts_settings_off_title">When this is off</string>
    <string name="read_receipts_settings_off_body">Zapp will not send read signals when you open messages, and it will not show read status from other people. Messages stay at sent instead of read.</string>
    <string name="read_receipts_settings_both_sides_title">If the other person has it off</string>
    <string name="read_receipts_settings_both_sides_body">Double ticks require both sides to allow read receipts. If either person turns them off, that chat behaves like sent-only status.</string>
    <string name="read_receipts_settings_section_control">Control</string>
    <string name="read_receipts_settings_toggle_title">Allow read receipts</string>
    <string name="read_receipts_settings_toggle_subtitle">Send and show read status when both sides allow it</string>
    <string name="read_receipts_settings_save">Save</string>
    <string name="chat_settings_online_status_toggle_title">Online status</string>
    <string name="online_status_settings_row_subtitle">Choose whether people see when you\'re online</string>
    <string name="online_status_settings_title">Online status</string>
    <string name="online_status_settings_intro">Your online status lets the people you chat with see when you\'re connected. It\'s optional, and it works both ways.</string>
    <string name="online_status_settings_on_title">When this is on</string>
    <string name="online_status_settings_on_body">People you have a direct chat with can see a small dot when you\'re connected, and you can see the same for them.</string>
    <string name="online_status_settings_off_title">When this is off</string>
    <string name="online_status_settings_off_body">People stop seeing when you\'re online, and Zapp also stops showing you when they\'re online. Your messages still send and arrive as usual.</string>
    <string name="online_status_settings_reciprocal_title">It works both ways</string>
    <string name="online_status_settings_reciprocal_body">Hiding your online status also hides everyone else\'s from you. Turn it back on to see and be seen again.</string>
    <string name="online_status_settings_section_control">Control</string>
    <string name="online_status_settings_toggle_title">Show my online status</string>
    <string name="online_status_settings_toggle_subtitle">Let people you chat with see when you\'re connected</string>
    <string name="online_status_settings_save">Save</string>
    <string name="chat_message_status_sending">Sending</string>
    <string name="chat_message_status_queued">Waiting for recipient to sync</string>
    <string name="chat_message_status_sent">Sent, awaiting delivery</string>
    <string name="chat_message_status_delivered">Delivered</string>
    <string name="chat_message_status_read">Read</string>
    <string name="chat_message_status_failed">Failed to send</string>
    <string name="background_delivery_settings_title">Background delivery</string>
    <string name="background_delivery_settings_intro">FOSS background delivery keeps an explicit no-Google listener running while Zapp is closed.</string>
    <string name="background_delivery_settings_delivery_title">When this is off</string>
    <string name="background_delivery_settings_delivery_body">Zapp stops the listener. Messages remain encrypted and synchronize the next time you open the app.</string>
    <string name="background_delivery_settings_battery_title">When this is on</string>
    <string name="background_delivery_settings_battery_body">Android shows a permanent “Zapp is running” notification and keeps an ntfy connection open. This uses more battery than checking only when the app is open.</string>
    <string name="background_delivery_settings_privacy_title">What the delivery signal contains</string>
    <string name="background_delivery_settings_privacy_body">The signal only tells Zapp to wake up and check for messages. Message contents stay encrypted and are fetched by your app after it wakes.</string>
    <string name="background_delivery_settings_section_control">Control</string>
    <string name="background_delivery_settings_toggle_title">Allow background delivery</string>
    <string name="background_delivery_settings_toggle_subtitle">Wake Zapp to check for waiting messages</string>
