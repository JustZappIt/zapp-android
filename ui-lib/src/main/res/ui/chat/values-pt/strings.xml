    <string name="chat_message_status_queued">A aguardar sincronização do destinatário</string>
    <string name="chat_message_status_sent">Enviada, a aguardar entrega</string>
    <string name="chat_message_status_delivered">Entregue</string>
    <string name="chat_message_status_read">Lido</string>
    <string name="chat_message_status_failed">Falha ao enviar</string>
    <string name="background_delivery_settings_title">Entrega em segundo plano</string>
    <string name="background_delivery_settings_intro">Controle se o Zapp pode continuar acessível quando o app está fechado ou seu telefone está bloqueado.</string>
    <string name="background_delivery_settings_delivery_title">Quando isto está desativado</string>
    <string name="background_delivery_settings_delivery_body">O Zapp para o ouvinte em segundo plano. As novas mensagens podem aguardar até você abrir o app; então o Zapp verifica o que chegou enquanto você estava ausente.</string>
    <string name="background_delivery_settings_battery_title">Quando isto está ativado</string>
    <string name="background_delivery_settings_battery_body">O Android mantém um serviço silencioso do Zapp ativo para que o app possa despertar e verificar quando uma mensagem pode estar aguardando. Isso melhora o tempo de entrega, mas usa mais bateria do que verificar apenas quando o app está aberto.</string>
    <string name="background_delivery_settings_privacy_title">O que o sinal de entrega contém</string>
    <string name="background_delivery_settings_privacy_body">O sinal apenas avisa o Zapp para despertar e verificar mensagens. O conteúdo das mensagens permanece criptografado e é buscado pelo seu app depois que ele desperta.</string>
    <string name="background_delivery_settings_section_control">Controle</string>
    <string name="background_delivery_settings_toggle_title">Permitir entrega em segundo plano</string>
    <string name="background_delivery_settings_toggle_subtitle">Despertar o Zapp para verificar mensagens pendentes</string>
