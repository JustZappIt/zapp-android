    <string name="chat_settings_section_privacy">Privacidade</string>
    <string name="chat_settings_read_receipts_toggle_title">Confirmações de leitura</string>
    <string name="chat_settings_read_receipts_toggle_subtitle">Mostra um tique duplo quando suas mensagens são lidas. Desative para também parar de ver quando leem as suas.</string>
    <string name="read_receipts_settings_row_subtitle">Controle os indicadores de enviado e lido nos chats</string>
    <string name="read_receipts_settings_title">Confirmações de leitura</string>
    <string name="read_receipts_settings_intro">As confirmações de leitura permitem que um chat mostre quando uma mensagem foi aberta. Elas são opcionais e só mostram o estado lido quando os dois lados permitem.</string>
    <string name="read_receipts_settings_on_title">Quando isto está ativado</string>
    <string name="read_receipts_settings_on_body">Quando você abre uma conversa, o Zapp pode enviar um pequeno sinal de leitura para as mensagens recebidas. Suas mensagens enviadas também podem mostrar um tique duplo próximo depois que o outro app confirmar que foram lidas.</string>
    <string name="read_receipts_settings_off_title">Quando isto está desativado</string>
    <string name="read_receipts_settings_off_body">O Zapp não enviará sinais de leitura quando você abrir mensagens e não mostrará o estado lido de outras pessoas. As mensagens permanecem como enviadas em vez de lidas.</string>
    <string name="read_receipts_settings_both_sides_title">Se a outra pessoa tiver desativado</string>
    <string name="read_receipts_settings_both_sides_body">Os tiques duplos exigem que os dois lados permitam confirmações de leitura. Se qualquer pessoa desativar, esse chat funciona apenas com estado enviado.</string>
    <string name="read_receipts_settings_section_control">Controle</string>
    <string name="read_receipts_settings_toggle_title">Permitir confirmações de leitura</string>
    <string name="read_receipts_settings_toggle_subtitle">Enviar e mostrar o estado lido quando os dois lados permitirem</string>
    <string name="read_receipts_settings_save">Salvar</string>
