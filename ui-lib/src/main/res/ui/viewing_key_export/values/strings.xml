    <!-- Info sheet. The detail the screen itself deliberately does not carry. -->
    <string name="viewing_key_export_info_title">About viewing keys</string>
    <string name="viewing_key_export_info_intro">A viewing key gives a dashboard or accounting tool read-only access to this account. It can never spend your funds.</string>
    <string name="viewing_key_export_info_ufvk_body">Shows incoming and outgoing payments, spends and balances. Appropriate for accounting.</string>
    <string name="viewing_key_export_info_uivk_body">Shows incoming payments only. It cannot see what you spend, so a balance calculated from it may read higher than it is.</string>
    <string name="viewing_key_export_info_irrevocable_title">This cannot be undone</string>
    <string name="viewing_key_export_info_irrevocable_body">Access continues for all future activity. The only way to revoke it is to move your funds to a new wallet account.</string>
    <string name="viewing_key_export_info_compatibility">Make sure the receiving tool supports Zcash unified viewing keys.</string>

